rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // จำกัดสิทธิ์เฉพาะพนักงาน (อีเมลเดียว) สำหรับการเขียน/แก้ไข/ลบ
    // อีเมลต้องเป็นตัวพิมพ์เล็ก และต้องสมัครบัญชีนี้ในแอปไว้แล้ว
    function isStaff() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'ikuyisad@ikwai.com';
    }

    // ทุกบัญชีที่เข้าสู่ระบบสามารถอ่านดูข้อมูล สต๊อก และประวัติได้ (Read-only)
    function isSignedIn() {
      return request.auth != null;
    }

    // NOTE: isValidId / isValidFoilRoll / isValidStockCutRecord below are
    // currently NOT referenced by any match block — every collection below is
    // gated on isStaff() alone. They are kept as the shape a future
    // field-validation pass should adopt.
    //
    // Do NOT wire isValidStockCutRecord in as-is: it requires
    // `totalDeducted >= 0`, but cycle-count adjustments legitimately write a
    // negative totalDeducted (physical stock > system stock = restock), so
    // enabling it would reject those writes. See StockCutRecord.totalDeducted
    // in src/types.ts — the field is signed by design.

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFoilRoll(data) {
      return data is map &&
        data.id is string && data.id.size() <= 128 &&
        data.lotNumber is string && data.lotNumber.size() <= 100 &&
        data.rollNumber is string && data.rollNumber.size() <= 100 &&
        data.width is number && data.width > 0 &&
        data.pattern is string && data.pattern.size() <= 100 &&
        data.totalMeters is number && data.totalMeters >= 0 &&
        data.remainingMeters is number && data.remainingMeters >= 0 &&
        data.status in ['active', 'depleted', 'out_of_stock'];
    }

    function isValidStockCutRecord(data) {
      return data is map &&
        data.id is string && data.id.size() <= 128 &&
        data.foilId is string && data.foilId.size() <= 128 &&
        data.soNumber is string && data.soNumber.size() <= 150 &&
        data.usedMeters is number && data.usedMeters >= 0 &&
        data.totalDeducted is number && data.totalDeducted >= 0 &&
        data.remainingAfter is number && data.remainingAfter >= 0 &&
        data.recordedBy is string && data.recordedBy.size() <= 150;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Foil rolls inventory collection — ทุกบัญชีที่เข้าสู่ระบบสามารถอ่านดูข้อมูลและดูม้วนที่หมดแล้วได้
    // แต่เฉพาะแอดมิน/พนักงานเท่านั้นที่สามารถเพิ่ม แก้ไข ตัดสต๊อก หรือลบข้อมูลได้
    match /foil_rolls/{rollId} {
      allow read: if isSignedIn();
      allow write: if isStaff();

      // Cuts subcollection per roll
      match /cuts/{cutId} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }

      // Cut history subcollection per roll (foil_rolls/{rollId}/cut_history)
      match /cut_history/{cutId} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    // Collection group query for cut_history across all rolls
    match /{path=**}/cut_history/{cutId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Stock cut records collection
    match /stock_cut_records/{recordId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // PU Sandwich cut records (no foil) collection
    match /pu_sandwich_cuts/{recordId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Physical Cycle Count sessions (monthly stock count + variance)
    match /cycle_counts/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
  }
}
