rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFoilRoll(data) {
      return data is map &&
        data.id is string && data.id.size() <= 128 &&
        data.lotNumber is string && data.lotNumber.size() <= 100 &&
        data.rollNumber is string && data.rollNumber.size() <= 100 &&
        data.width is number && data.width > 0 &&
        data.pattern is string && data.pattern.size() <= 100 &&
        data.totalMeters is number && data.totalMeters >= 0 &&
        data.remainingMeters is number && data.remainingMeters >= 0 &&
        data.status in ['active', 'depleted'];
    }

    function isValidStockCutRecord(data) {
      return data is map &&
        data.id is string && data.id.size() <= 128 &&
        data.foilId is string && data.foilId.size() <= 128 &&
        data.soNumber is string && data.soNumber.size() <= 150 &&
        data.usedMeters is number && data.usedMeters >= 0 &&
        data.totalDeducted is number && data.totalDeducted >= 0 &&
        data.remainingAfter is number && data.remainingAfter >= 0 &&
        data.recordedBy is string && data.recordedBy.size() <= 150;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Foil rolls inventory collection
    match /foil_rolls/{rollId} {
      allow read: if true;
      allow create: if isValidId(rollId) && isValidFoilRoll(request.resource.data);
      allow update: if isValidId(rollId) && isValidFoilRoll(request.resource.data);
      allow delete: if isValidId(rollId);

      // Cuts subcollection per roll
      match /cuts/{cutId} {
        allow read: if true;
        allow create: if isValidId(cutId) && isValidStockCutRecord(request.resource.data);
        allow update: if isValidId(cutId) && isValidStockCutRecord(request.resource.data);
        allow delete: if isValidId(cutId);
      }
    }

    // Stock cut records collection
    match /stock_cut_records/{recordId} {
      allow read: if true;
      allow create: if isValidId(recordId) && isValidStockCutRecord(request.resource.data);
      allow update: if isValidId(recordId) && isValidStockCutRecord(request.resource.data);
      allow delete: if isValidId(recordId);
    }
  }
}
