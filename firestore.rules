rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFoilRoll(data) {
      return data is map &&
        data.id is string && data.id.size() <= 128 &&
        data.lotNumber is string && data.lotNumber.size() <= 100 &&
        data.rollNumber is string && data.rollNumber.size() <= 100 &&
        data.width is number && data.width > 0 &&
        data.pattern is string && data.pattern.size() <= 100 &&
        data.totalMeters is number && data.totalMeters >= 0 &&
        data.remainingMeters is number && data.remainingMeters >= 0 &&
        data.status in ['active', 'depleted', 'out_of_stock'];
    }

    function isValidStockCutRecord(data) {
      return data is map &&
        data.id is string && data.id.size() <= 128 &&
        data.foilId is string && data.foilId.size() <= 128 &&
        data.soNumber is string && data.soNumber.size() <= 150 &&
        data.usedMeters is number && data.usedMeters >= 0 &&
        data.totalDeducted is number && data.totalDeducted >= 0 &&
        data.remainingAfter is number && data.remainingAfter >= 0 &&
        data.recordedBy is string && data.recordedBy.size() <= 150;
    }

    // Physical Cycle Count entries: server-enforced rule that closes the
    // "reason is only checked client-side" gap WITHOUT needing a Cloud
    // Function. Firestore rejects the write itself (permission-denied) if
    // there's a non-zero variance with no reason attached — a modified or
    // malicious client can no longer skip this requirement.
    function isValidCycleCount(data) {
      return data is map &&
        data.rollId is string && data.rollId.size() > 0 &&
        data.sessionId is string && data.sessionId.size() > 0 &&
        data.systemMeters is number &&
        data.physicalMeters is number && data.physicalMeters >= 0 &&
        data.varianceMeters is number &&
        data.countedBy is string && data.countedBy.size() > 0 &&
        (
          data.varianceMeters == 0 ||
          (('reason' in data) && data.reason is string && data.reason.size() > 0)
        );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Foil rolls inventory collection
    match /foil_rolls/{rollId} {
      allow read, write: if true;

      // Cuts subcollection per roll
      match /cuts/{cutId} {
        allow read, write: if true;
      }

      // Cut history subcollection per roll (foil_rolls/{rollId}/cut_history)
      match /cut_history/{cutId} {
        allow read, write: if true;
      }
    }

    // Collection group query for cut_history across all rolls
    match /{path=**}/cut_history/{cutId} {
      allow read, write: if true;
    }

    // Stock cut records collection
    match /stock_cut_records/{recordId} {
      allow read, write: if true;
    }

    // PU Sandwich cut records (no foil) collection
    match /pu_sandwich_cuts/{recordId} {
      allow read, write: if true;
    }

    // Physical Cycle Count audit trail — read/delete open (internal tool),
    // but create/update must satisfy isValidCycleCount (reason required
    // whenever there's a variance). This is what actually stops a variance
    // being saved with no reason, even if someone tampers with the client.
    match /cycle_counts/{entryId} {
      allow read, delete: if true;
      allow create, update: if isValidCycleCount(request.resource.data);
    }
  }
}
