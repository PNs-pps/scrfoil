rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== จำกัดสิทธิ์เฉพาะพนักงาน (อีเมลที่อนุญาต) =====
    // อ่าน: ผู้ที่ล็อกอินแล้วทุกคน | เขียน/แก้ไข/ลบ: เฉพาะอีเมลใน allowlist ด้านล่าง
    // หมายเหตุ: ไม่บังคับ email_verified เพราะบัญชี Google ที่ล็อกอินผ่านแอปถูกยืนยันอยู่แล้ว
    // และการเช็ค claim นี้เคยทำให้บาง token เข้าไม่ได้
    function isStaff() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          'ikuyisad@ikwai.com'
        ];
    }

    // ทุกบัญชีที่เข้าสู่ระบบสามารถอ่านดูข้อมูล สต๊อก และประวัติได้ (Read-only)
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFoilRoll(data) {
      return data is map &&
        data.id is string && data.id.size() <= 128 &&
        data.lotNumber is string && data.lotNumber.size() <= 100 &&
        data.rollNumber is string && data.rollNumber.size() <= 100 &&
        data.width is number && data.width > 0 &&
        data.pattern is string && data.pattern.size() <= 100 &&
        data.totalMeters is number && data.totalMeters >= 0 &&
        data.remainingMeters is number && data.remainingMeters >= 0 &&
        data.status in ['active', 'depleted', 'out_of_stock'];
    }

    function isValidStockCutRecord(data) {
      return data is map &&
        data.id is string && data.id.size() <= 128 &&
        data.foilId is string && data.foilId.size() <= 128 &&
        data.soNumber is string && data.soNumber.size() <= 150 &&
        data.usedMeters is number && data.usedMeters >= 0 &&
        data.totalDeducted is number && data.totalDeducted >= 0 &&
        data.remainingAfter is number && data.remainingAfter >= 0 &&
        data.recordedBy is string && data.recordedBy.size() <= 150;
    }

    // NOTE: isValidId / isValidFoilRoll / isValidStockCutRecord ด้านบนยังไม่ได้ถูกอ้างอิง
    // ใน match block ใด ๆ (ทุก collection ใช้ isStaff() คุมการเขียน) เก็บไว้เป็นแบบร่าง
    // สำหรับการตรวจ field ในอนาคต
    //
    // ห้าม wire isValidStockCutRecord เข้ามาใช้ตรง ๆ: มันบังคับ `totalDeducted >= 0`
    // แต่การนับสต๊อก (cycle count) เขียนค่าติดลบได้ (ของจริง > ระบบ = คืนยอดเข้าสต๊อก)
    // ดู StockCutRecord.totalDeducted ใน src/types.ts — ฟิลด์นี้เป็น signed โดยตั้งใจ

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Foil rolls inventory collection — อ่านได้ทุกบัญชีที่ล็อกอิน เขียนได้เฉพาะพนักงาน
    match /foil_rolls/{rollId} {
      allow read: if isSignedIn();
      allow write: if isStaff();

      // Cuts subcollection per roll
      match /cuts/{cutId} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }

      // Cut history subcollection per roll (foil_rolls/{rollId}/cut_history)
      match /cut_history/{cutId} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    // Collection group query for cut_history across all rolls
    match /{path=**}/cut_history/{cutId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Stock cut records collection
    match /stock_cut_records/{recordId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // PU Sandwich cut records (no foil) collection
    match /pu_sandwich_cuts/{recordId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Physical Cycle Count sessions (monthly stock count + variance)
    match /cycle_counts/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // SO Audit logs (Audit Trail & Change Diff)
    match /so_audit_logs/{logId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
  }
}
